{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codepluse",
  "version": "0.42.0",
  "identifier": "com.codepluse.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main-shell"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/workspace.json"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
